# ==========================================
# Smart Pantry Expiry Tracker - Environment Variables
# ==========================================

# Backend Database (SQLite by default, or PostgreSQL)
# For local: sqlite:///./pantry.db
# For Render with persistent disk: sqlite:////data/pantry.db
# For PostgreSQL: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./pantry.db

# Allowed CORS Origins (comma-separated or * for all)
CORS_ORIGINS=*

# Backend Port (Render sets this dynamically)
PORT=8000

# Frontend API URL (points to your backend)
# Local: http://localhost:8000
# Production: https://your-render-backend-url.onrender.com
VITE_API_URL=http://localhost:8000
